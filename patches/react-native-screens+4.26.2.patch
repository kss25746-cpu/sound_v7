+     * over it -- the tab content underneath (which now extends into that area, since the interface inset
+     * dropped to 0) goes dead in exactly that strip. Collapse the hidden bar to an empty frame at the
+     * container's bottom edge so neither it nor its (equally stale) children can satisfy a hit test.
+     */
+    private fun collapseHiddenBottomNavigationViewFrame() {
+        if (bottomNavigationView.visibility != View.GONE) {
+            return
+        }
+        val edge = height
+        if (bottomNavigationView.left != 0 ||
+            bottomNavigationView.top != edge ||
+            bottomNavigationView.right != 0 ||
+            bottomNavigationView.bottom != edge
+        ) {
+            bottomNavigationView.layout(0, edge, 0, edge)
+        }
+    }
